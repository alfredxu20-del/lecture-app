# Turso 云数据库（必填；不要提交真实值）
TURSO_DB_URL=libsql://your-database-your-account.turso.io
TURSO_AUTH_TOKEN=replace_with_your_turso_token

# DeepSeek 信息识别（使用 AI 录入时必填）
DEEPSEEK_API_KEY=replace_with_your_deepseek_key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 访客录入口令（必填，请使用自己的口令）
GUEST_PASSCODE=replace_with_your_guest_passcode

# 仅启用 HTTPS 时需要：填写已解析到 VPS 的域名，不带 https://
DOMAIN=lectures.example.com
